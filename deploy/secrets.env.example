# Copy to /etc/indra/secrets.env (owner root, mode 0600). Never commit the real file.

# Proxmox, read-only API token with the PVEAuditor role.
PROXMOX_HOST=https://192.168.1.200:8006
PROXMOX_TOKEN_ID=indra@pve!dashboard
PROXMOX_TOKEN_SECRET=
# Proxmox ships a self-signed cert. Set to false only on the LAN/tailnet.
PROXMOX_VERIFY_TLS=false

# Optional. Defaults: pluto at http://192.168.1.120:9100/metrics.
# NODE_EXPORTER_TARGETS=pluto=http://100.101.119.88:9100/metrics

# Optional. Defaults: /var/run/tailscale/tailscaled.sock, then the `tailscale` CLI.
# TAILSCALE_SOCKET=/var/run/tailscale/tailscaled.sock
# TAILSCALE_BIN=/usr/bin/tailscale
